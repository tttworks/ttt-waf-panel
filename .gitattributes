# 统一行尾为 LF —— 否则 Windows 上 clone/提交会把 shell 脚本转成 CRLF，
# 在 Linux 上执行会报 "bad interpreter: /usr/bin/env bash^M"。
* text=auto eol=lf

# 明确按文本处理（eol=lf）
*.sh    text eol=lf
*.bash  text eol=lf
*.php   text eol=lf
*.py    text eol=lf
*.conf  text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.example.json text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf

# 二进制文件不做行尾转换
*.mmdb  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.db    binary
